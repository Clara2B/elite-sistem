# Copie para ".env" (mesma pasta) para desenvolvimento local.
# NUNCA preencha valores reais aqui e commite — este arquivo é só o modelo.

ENV=development

# Connection string do Supabase (Postgres). Deixe vazio para rodar sem banco
# ainda (Fase 2). Será necessária a partir da Fase 3.
DATABASE_URL=

# Só usados uma vez, para criar o primeiro Admin Superior quando o banco
# ainda não tem nenhum usuário (ver README.md "Autenticação"). Depois do
# primeiro login, os demais usuários são criados por POST /usuarios.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_SENHA=

# Pop-up de suporte — o chamado é salvo direto no banco (tela de
# Configuração > Chamados), sem depender de nenhuma variável aqui. Esta é
# opcional: um webhook de canal do Discord (Configurações do canal >
# Integrações > Webhooks, em qualquer servidor) pra avisar na hora que um
# chamado for aberto, além de ele já ficar salvo na tela.
DISCORD_WEBHOOK_SUPORTE=

# Fase 1 — Solicitação de Audiência: acesso à planilha de controle (Google
# Sheets) via conta de serviço do Google (ver app/services/google_sheets.py
# e README.md). GOOGLE_SERVICE_ACCOUNT_JSON é o conteúdo inteiro do .json
# da conta de serviço (não um caminho de arquivo) — a conta de serviço
# precisa ter permissão de Editor na planilha. GOOGLE_SHEETS_ID é o ID da
# planilha (trecho entre /d/ e /edit na URL); em dev, use uma cópia com
# dados fictícios, nunca a planilha real.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_ID=

# Envio das Cartas Convite por e-mail (Fase 1 — Solicitação de Audiência),
# via Postmark (ver app/services/email_postmark.py). POSTMARK_REMETENTE
# precisa ser um e-mail com Sender Signature (ou domínio) verificado na
# conta Postmark.
POSTMARK_SERVER_TOKEN=
POSTMARK_REMETENTE=
# Modo de teste é o padrão (ausente = false): todo e-mail vai só pra
# EMAIL_DESTINATARIO_TESTE, nunca pro cliente/banco real. Só ligar
# EMAIL_ENVIO_REAL=true em produção, quando a Clara decidir.
EMAIL_ENVIO_REAL=
EMAIL_DESTINATARIO_TESTE=
